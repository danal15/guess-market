<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ChatController" spacing="6" styleClass="pane-box">
    <padding>
        <Insets top="6" right="8" bottom="8" left="8"/>
    </padding>

    <ListView fx:id="messageList" prefHeight="150" minHeight="80">
        <VBox.vgrow>
            <Priority fx:constant="ALWAYS"/>
        </VBox.vgrow>
    </ListView>

    <HBox spacing="8">
        <TextField fx:id="messageField" promptText="Say something to everyone" onAction="#onSend">
            <HBox.hgrow>
                <Priority fx:constant="ALWAYS"/>
            </HBox.hgrow>
        </TextField>
        <Button fx:id="sendButton" text="Send" onAction="#onSend"/>
    </HBox>
</VBox>
